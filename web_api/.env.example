ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://user:password@database-host:5432/ksdb
ADMIN_API_KEY=replace-with-a-long-random-secret
VIEWER_API_KEY=replace-with-a-different-long-random-secret
WEB_ALLOWED_ORIGINS=https://kotak-school-data-hub.buzzycoot64.chatgpt.site

# Scheduled Google Sheets sync. Store these as GitHub production-environment
# secrets; GOOGLE_SERVICE_ACCOUNT_JSON is the complete service-account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_STUDENT_SHEET_2024_25=
GOOGLE_STUDENT_SHEET_2025_26=
GOOGLE_STUDENT_SHEET_2026_27=
GOOGLE_FEE_SHEET_2024_25=
GOOGLE_FEE_SHEET_2025_26=
GOOGLE_FEE_SHEET_2026_27=
GOOGLE_STUDENT_UNIQUE_KEY=ADM_NO
GOOGLE_SYNC_MIN_ROWS=10

# Pipeline execution remains disabled until each reviewed command is configured.
ENABLE_PIPELINE_EXECUTION=false
REFRESH_STUDENTS_COMMAND=
REFRESH_FEES_COMMAND=
REFRESH_DAYWISE_COMMAND=
REFRESH_CONCESSIONS_COMMAND=
REFRESH_TRANSACTIONS_COMMAND=
REFRESH_ATTENDANCE_COMMAND=
REFRESH_ALL_COMMAND=

# Required only when refresh execution is enabled.
BACKUP_DIR=/app/backups
PG_DUMP_PATH=/usr/bin/pg_dump
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=ksdb


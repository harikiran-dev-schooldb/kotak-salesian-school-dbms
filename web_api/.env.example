ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg2://user:password@database-host:5432/ksdb
ADMIN_API_KEY=replace-with-a-long-random-secret
VIEWER_API_KEY=replace-with-a-different-long-random-secret
WEB_ALLOWED_ORIGINS=https://kotak-school-data-hub.buzzycoot64.chatgpt.site

# Pipeline execution remains disabled until each reviewed command is configured.
ENABLE_PIPELINE_EXECUTION=false
REFRESH_STUDENTS_COMMAND=
REFRESH_FEES_COMMAND=
REFRESH_DAYWISE_COMMAND=
REFRESH_CONCESSIONS_COMMAND=
REFRESH_TRANSACTIONS_COMMAND=
REFRESH_ATTENDANCE_COMMAND=
REFRESH_ALL_COMMAND=

# Required only when refresh execution is enabled.
BACKUP_DIR=/app/backups
PG_DUMP_PATH=/usr/bin/pg_dump
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=ksdb

